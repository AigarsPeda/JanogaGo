# JāņogaGO droplet configuration
#
# When the droplet exists, copy this file to `scripts/janogago-droplet.env` and
# replace every TODO value. The real file is intentionally ignored by Git.
# Do not put passwords, API tokens, or private keys in this repository.

# TODO: new droplet SSH details.
SSH_KEY="/Users/aigarspeda/.ssh/REPLACE_WITH_JANOGAGO_DROPLET_KEY"
REMOTE_HOST="root@REPLACE_WITH_DROPLET_IP"
REMOTE_WP_PATH="/var/www/janogago"
REMOTE_URL="https://REPLACE_WITH_JANOGAGO_DOMAIN"
REMOTE_BACKUP_DIR="/var/backups/janogago"

# Local by Flywheel site.
LOCAL_URL="http://janogago.local"
LOCAL_WP_PATH="/Users/aigarspeda/Local Sites/janogago/app/public"
LOCAL_UPLOADS_PATH="/Users/aigarspeda/Local Sites/janogago/app/public/wp-content/uploads"
REMOTE_UPLOADS_PATH="/var/www/janogago/wp-content/uploads"
LOCAL_WP_CLI="/Applications/Local.app/Contents/Resources/extraResources/bin/wp-cli/wp-cli.phar"

# TODO: copy these three Local runtime paths after checking the JanogaGo site.
# They can change when Local is updated or the site is recreated.
LOCAL_PHP_BIN=""
LOCAL_PHP_INI=""
LOCAL_MYSQL_BIN_DIR=""
LOCAL_MYSQL_SOCKET=""

# Optional settings.
BACKUP_DIR=""
BACKUP_KEEP="3"
